{
  "name": "mindpause",
  "productName": "Mind Pause",
  "version": "0.0.1",
  "description": "An offline desktop pause between an impulse and acting on it.",
  "license": "GPL-3.0-or-later",
  "private": true,
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "clean": "rm -rf dist release",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "pnpm run clean && pnpm run build:main && pnpm run build:renderer",
    "start": "pnpm run build && electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && svelte-check --tsconfig tsconfig.renderer.json",
    "lint": "eslint .",
    "lint:prove": "node scripts/prove-lint-rules.mjs",
    "test": "vitest run",
    "test:core": "vitest run test/unit",
    "deps:check": "node scripts/check-deps.mjs",
    "identity:check": "node scripts/check-identity.mjs",
    "gates": "pnpm run lint && pnpm run typecheck && pnpm run deps:check && pnpm run identity:check && pnpm run lint:prove && pnpm run test",
    "pack:dir": "pnpm run build && electron-builder --dir",
    "dist:linux": "pnpm run build && electron-builder --linux",
    "dist:win": "pnpm run build && electron-builder --win",
    "dist:mac": "pnpm run build && electron-builder --mac"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.2",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "eslint": "10.11.0",
    "eslint-plugin-svelte": "3.23.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "author": {
    "name": "programmer-nur",
    "email": "mohammadnur5480@gmail.com"
  },
  "homepage": "https://github.com/programmer-nur/mind-pause",
  "desktopName": "io.github.programmer_nur.MindPause.desktop"
}
