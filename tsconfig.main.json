{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "node16",
    "moduleResolution": "node16",
    "rootDir": "src",
    "outDir": "dist",
    "types": [
      "node"
    ],
    "sourceMap": true
  },
  "include": [
    "src/core/**/*.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts"
  ]
}
